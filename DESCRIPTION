Package: pidigits
Type: Package
Title: Arbitrary Precision Digits of Pi with Memoisation
Version: 0.1.0
Authors@R: 
    person("J Kyle", "Armstrong", email = "ComputeGate@gmail.com", role = c("aut", "cre"),
           comment = c(
               ORCID = "0000-0002-4269-0121",
